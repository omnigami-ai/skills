{
 "url": "http://localhost:4413/lamplit/app/#/runs",
 "viewport": "desktop",
 "ready": "[data-ready]",
 "rects": {
  "timeline": "[data-panel=\"timeline\"]",
  "table": "[data-panel=\"runs-table\"]",
  "row": "[data-run=\"4812\"]",
  "head": ".run-head",
  "status": ".run-head .pill",
  "replay": "[data-action=\"replay-from-step\"]",
  "waterfall": "[data-panel=\"waterfall\"]",
  "logs": "[data-panel=\"logs\"]",
  "errors": ".ll.err*",
  "details": "[data-panel=\"details\"]",
  "outcome": "[data-outcome]",
  "newSchedule": "[data-panel=\"new-schedule\"]",
  "scheduleField": "[data-field=\"schedule\"]",
  "cron": "[data-cron]",
  "nextRuns": "[data-next-runs]"
 },
 "steps": [
  { "rects": "runs" },
  { "capture": "runs", "full": true, "scale": 3 },
  { "drag": [[420, 557], [420, 557]], "capture": "runs-pressed", "frames": 2, "full": true, "scale": 3 },
  { "eval": "location.hash = '#/runs/4812'" },
  { "wait": 300 },
  { "rects": "failed" },
  { "capture": "failed", "full": true, "scale": 3 },
  { "drag": [[1276, 120], [1276, 120]], "capture": "replay-pressed", "frames": 2, "full": true, "scale": 3 },
  { "wait": 300 },
  { "rects": "queued" },
  { "capture": "queued", "full": true, "scale": 3 },
  { "eval": "lamplit.replay('running')" },
  { "rects": "running" },
  { "capture": "running", "full": true, "scale": 3 },
  { "eval": "lamplit.replay('succeeded')" },
  { "rects": "succeeded" },
  { "capture": "succeeded", "full": true, "scale": 3 },
  { "eval": "location.hash = '#/schedules'" },
  { "wait": 300 },
  { "rects": "schedule" },
  { "capture": "schedules", "full": true, "scale": 3 },
  { "click": "[data-field=\"schedule\"]" },
  { "capture": "sched-00", "around": "[data-panel=\"new-schedule\"]", "pad": 0, "scale": 3 },
  { "type": "[data-field=\"schedule\"]", "text": "every weekday at 9am", "capture": "sched", "around": "[data-panel=\"new-schedule\"]", "pad": 0, "scale": 3 },
  { "rects": "typed" }
 ]
}
